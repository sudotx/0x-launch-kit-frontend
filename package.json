        "logdown": "3.3.1",
        "query-string": "9.2.2",
        "react": "19.1.1",
        "react-dom": "19.1.1",
        "react-modal": "3.16.3",
        "react-redux": "9.2.0",
        "react-router": "7.8.2",
        "react-router-dom": "7.8.2",
        "react-svg": "16.3.0",
        "react-timeago": "8.3.0",
        "react-tooltip": "^5.29.1",
        "recharts": "3.1.2",
        "redux": "5.0.1",
        "redux-thunk": "3.1.0",
        "reselect": "5.1.1",
        "sanitize.css": "13.0.0",
        "styled-components": "6.1.19",
